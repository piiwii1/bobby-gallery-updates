diff --git a/windows/src/glass.rs b/windows/src/glass.rs
new file mode 100644
--- /dev/null
+++ b/windows/src/glass.rs
@@ -0,0 +1,209 @@
+//! PiiWii Rainhush water glass: transient desktop shortcut, live rain-filled cursor,
+//! and right-click to pour. All shell and cursor changes are cleaned up on exit.
+use std::ffi::c_void;
+use std::os::windows::ffi::OsStrExt;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, AtomicIsize, Ordering};
+
+use windows::Win32::Foundation::{HWND, LPARAM, LRESULT, POINT, WPARAM};
+use windows::Win32::System::Com::{CLSCTX_INPROC_SERVER, CoCreateInstance, CoTaskMemFree, IPersistFile};
+use windows::Win32::UI::Shell::{FOLDERID_Desktop, IShellLinkW, KF_FLAG_CREATE, SHGetKnownFolderPath, ShellLink};
+use windows::Win32::UI::WindowsAndMessaging::{
+    CallNextHookEx, GetCursorPos, HHOOK, IMAGE_CURSOR, LR_LOADFROMFILE, LoadImageW, OCR_NORMAL,
+    SPI_SETCURSORS, SetSystemCursor, SetWindowsHookExW, SystemParametersInfoW,
+    SYSTEM_PARAMETERS_INFO_UPDATE_FLAGS, UnhookWindowsHookEx, WH_MOUSE_LL, WM_APP, WM_RBUTTONDOWN, PostMessageW,
+};
+use windows::core::{Interface, PCWSTR, w};
+
+static CONTROLLER: AtomicIsize = AtomicIsize::new(0);
+static CATCH_RIGHT: AtomicBool = AtomicBool::new(false);
+const POUR_MESSAGE: u32 = WM_APP + 4;
+
+fn wide(s: &std::ffi::OsStr) -> Vec<u16> { s.encode_wide().chain([0]).collect() }
+fn storage() -> PathBuf { std::env::temp_dir().join("Rainhush-PiiWii-Glass") }
+
+fn desktop_shortcut() -> Option<PathBuf> {
+    unsafe {
+        let ptr = SHGetKnownFolderPath(&FOLDERID_Desktop, KF_FLAG_CREATE, None).ok()?;
+        let text = ptr.to_string().ok();
+        CoTaskMemFree(Some(ptr.0 as *const c_void));
+        text.map(|dir| PathBuf::from(dir).join("Verre d'eau - Rainhush.lnk"))
+    }
+}
+
+/// Store a real Explorer desktop icon only while the rain is active.
+pub fn shortcut(raining: bool) {
+    let Some(at) = desktop_shortcut() else { return };
+    if !raining {
+        let _ = std::fs::remove_file(at);
+        return;
+    }
+    let Ok(exe) = std::env::current_exe() else { return };
+    let _ = std::fs::create_dir_all(storage());
+    let icon = storage().join("verre-eau.ico");
+    let _ = std::fs::write(&icon, image_file(7, false, false));
+    let exew = wide(exe.as_os_str());
+    let iconw = wide(icon.as_os_str());
+    let atw = wide(at.as_os_str());
+    unsafe {
+        let result = (|| -> windows::core::Result<()> {
+            let link: IShellLinkW = CoCreateInstance(&ShellLink, None, CLSCTX_INPROC_SERVER)?;
+            link.SetPath(PCWSTR(exew.as_ptr()))?;
+            link.SetArguments(w!("--glass"))?;
+            link.SetDescription(w!("Verre d'eau Rainhush : remplir sous la pluie, clic droit pour verser"))?;
+            link.SetIconLocation(PCWSTR(iconw.as_ptr()), 0)?;
+            link.cast::<IPersistFile>()?.Save(PCWSTR(atw.as_ptr()), true)
+        })();
+        if let Err(error) = result { crate::log!("glass shortcut: {error}"); }
+    }
+}
+
+/// Source artwork is generated as a 48x48 32-bit BGRA icon or cursor. No external assets.
+fn image_file(fill: u8, tilted: bool, cursor: bool) -> Vec<u8> {
+    const N: usize = 48;
+    let mut pixels = Vec::with_capacity(N*N*4);
+    let theta: f32 = if tilted { -0.64 } else { 0.0 };
+    let c = theta.cos();
+    let s = theta.sin();
+    for y in (0..N).rev() {
+        for x in 0..N {
+            let xx = x as f32 - 24.0;
+            let yy = y as f32 - 22.0;
+            let px = xx*c + yy*s + 24.0;
+            let py = -xx*s + yy*c + 22.0;
+            let mut b = 0u8; let mut g = 0u8; let mut r = 0u8; let mut a = 0u8;
+            let mouth = (px-24.0).powi(2)/140.0 + (py-9.0).powi(2)/13.0;
+            let edge_left = 12.5 + (py-9.0)*0.055;
+            let edge_right = 35.5 - (py-9.0)*0.055;
+            let body = py >= 10.0 && py <= 37.0 && px >= edge_left && px <= edge_right;
+            let inside = py >= 11.5 && py <= 36.0 && px > edge_left+2.0 && px < edge_right-2.0;
+            if body {
+                (b,g,r,a) = (178, 139, 108, 185);
+                if inside { (b,g,r,a) = (210, 202, 190, 62); }
+                if inside && py >= 37.0 - (fill as f32/10.0)*25.0 {
+                    (b,g,r,a) = (255, 175 + (px as u8 % 15), 32, 218);
+                    if ((px-20.0).powi(2)+(py-17.0).powi(2)) < 5.0 { (b,g,r,a)=(255,236,149,235); }
+                }
+                if px < edge_left+2.4 || px > edge_right-2.4 || py > 34.8 {
+                    (b,g,r,a)=(188,148,116,239);
+                }
+            }
+            if mouth <= 1.0 && (mouth >= 0.51 || py < 8.7) { (b,g,r,a)=(233,219,204,255); }
+            if py >= 38.0 && py <= 40.0 && (px-24.0).abs() < 11.0 { (b,g,r,a)=(200,170,145,221); }
+            if tilted && x > 36 && y > 15 && y < 32 && (x + 2*y)%7 < 3 {
+                (b,g,r,a)=(250,159,25,225);
+            }
+            pixels.extend_from_slice(&[b,g,r,a]);
+        }
+    }
+    // ICO/CUR with BITMAPINFOHEADER and a standard 1-bit transparency mask.
+    let mut data=Vec::new();
+    data.extend_from_slice(&40u32.to_le_bytes());
+    data.extend_from_slice(&(N as i32).to_le_bytes());
+    data.extend_from_slice(&((2*N) as i32).to_le_bytes());
+    data.extend_from_slice(&1u16.to_le_bytes());
+    data.extend_from_slice(&32u16.to_le_bytes());
+    data.extend_from_slice(&0u32.to_le_bytes());
+    data.extend_from_slice(&((N*N*4) as u32).to_le_bytes());
+    data.extend_from_slice(&[0u8;16]);
+    data.extend_from_slice(&pixels);
+    for row in 0..N {
+        for byte in 0..8usize {
+            let mut mask=0u8;
+            for bit in 0..8 { let col=byte*8+bit; if col < N && pixels[(row*N+col)*4+3] == 0 { mask |= 1 << (7-bit); } }
+            data.push(mask);
+        }
+    }
+    let mut file=Vec::new();
+    file.extend_from_slice(&0u16.to_le_bytes());
+    file.extend_from_slice(&(if cursor {2u16} else {1u16}).to_le_bytes());
+    file.extend_from_slice(&1u16.to_le_bytes());
+    file.extend_from_slice(&[48u8,48u8,0u8,0u8]);
+    file.extend_from_slice(&(if cursor {23u16} else {1u16}).to_le_bytes());
+    file.extend_from_slice(&(if cursor {10u16} else {32u16}).to_le_bytes());
+    file.extend_from_slice(&(data.len() as u32).to_le_bytes());
+    file.extend_from_slice(&22u32.to_le_bytes());
+    file.extend_from_slice(&data);
+    file
+}
+
+unsafe extern "system" fn mouse_hook(code:i32,wp:WPARAM,lp:LPARAM) -> LRESULT {
+    if code >= 0 && wp.0 as u32 == WM_RBUTTONDOWN && CATCH_RIGHT.load(Ordering::Relaxed) {
+        let hwnd=CONTROLLER.load(Ordering::Relaxed);
+        if hwnd != 0 {
+            let _=unsafe { PostMessageW(Some(HWND(hwnd as _)), POUR_MESSAGE, WPARAM(0), LPARAM(0)) };
+            return LRESULT(1);
+        }
+    }
+    unsafe { CallNextHookEx(None, code, wp, lp) }
+}
+
+fn restore_pointer() {
+    unsafe { let _ = SystemParametersInfoW(SPI_SETCURSORS, 0, None, SYSTEM_PARAMETERS_INFO_UPDATE_FLAGS(0)); }
+}
+
+fn cursor(level:u8, tilted:bool) {
+    let _=std::fs::create_dir_all(storage());
+    let path=storage().join(format!("glass-{}-{}.cur", level, if tilted {1} else {0}));
+    if std::fs::write(&path, image_file(level, tilted, true)).is_err() { return; }
+    let pathw=wide(path.as_os_str());
+    unsafe {
+        if let Ok(handle)=LoadImageW(None, PCWSTR(pathw.as_ptr()), IMAGE_CURSOR, 48,48,LR_LOADFROMFILE) {
+            // SetSystemCursor assumes ownership; never DestroyCursor(handle) afterwards.
+            let _=SetSystemCursor(windows::Win32::UI::WindowsAndMessaging::HCURSOR(handle.0),OCR_NORMAL);
+        }
+    }
+}
+
+pub struct Glass {
+    pub active: bool,
+    pub level: u8,
+    hook: Option<HHOOK>,
+    tilted_ticks: u8,
+}
+impl Glass {
+    pub fn new()->Glass { Glass { active:false,level:0,hook:None,tilted_ticks:0 } }
+    pub fn toggle(&mut self, controller:HWND, raining:bool) {
+        if !raining { self.stop(); return; }
+        if self.active { self.stop(); return; }
+        self.active=true;

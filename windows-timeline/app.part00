def resource_path(name: str) -> Path:
    base = Path(getattr(sys, "_MEIPASS", Path(__file__).resolve().parent))
    return base / name


def run(cmd, *, env=None, cwd=None, input_text=None, timeout=None, check=True, hidden=True):
    startupinfo = None
    creationflags = 0
    if os.name == "nt" and hidden:
        startupinfo = subprocess.STARTUPINFO()
        startupinfo.dwFlags |= subprocess.STARTF_USESHOWWINDOW
        creationflags = subprocess.CREATE_NO_WINDOW
    p = subprocess.run(
        [str(x) for x in cmd], cwd=str(cwd) if cwd else None, env=env,
        input=input_text, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        timeout=timeout, startupinfo=startupinfo, creationflags=creationflags
    )
    if check and p.returncode != 0:
        raise RuntimeError((p.stdout or "").strip() or f"Commande échouée: {cmd[0]}")
    return p


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def download(url: str, dst: Path, progress=None):
    dst.parent.mkdir(parents=True, exist_ok=True)
    req = urllib.request.Request(url, headers={"User-Agent": f"{APP_NAME}/{APP_VERSION}"})
    with urllib.request.urlopen(req, timeout=60) as r, dst.open("wb") as f:
        total = int(r.headers.get("Content-Length") or 0)
        done = 0
        while True:
            b = r.read(1024 * 1024)
            if not b:
                break
            f.write(b)
            done += len(b)
            if progress and total:
                progress(done, total)


def unzip(src: Path, dst: Path):
    if dst.exists():
        shutil.rmtree(dst)
    dst.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(src) as z:
        z.extractall(dst)


def java_home_usable(home: Path):
    try:
        p = run([home / "bin" / "java.exe", "-version"], check=False, timeout=15)
        text = p.stdout or ""
        import re
        m = re.search(r'version ["\'](\d+)', text)
        if not m:
            return False
        return int(m.group(1)) >= 17
    except Exception:
        return False


def find_java_home():
    existing = shutil.which("java")
    if existing:
        p = Path(existing).resolve().parent.parent
        if java_home_usable(p):
            return p
    if JDK.exists():
        for p in JDK.rglob("java.exe"):
            if p.parent.name.lower() == "bin" and java_home_usable(p.parent.parent):
                return p.parent.parent
    return None

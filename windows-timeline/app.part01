
    def ui(self, status=None, detail=None):
        def apply():
            if status is not None:
                self.status.set(status)
            if detail is not None:
                self.detail.set(detail)
        self.after(0, apply)

    def ask_licenses(self):
        result = {"v": False}
        evt = threading.Event()
        def ask():
            result["v"] = messagebox.askyesno(
                "Licences Android SDK",
                "La première installation doit télécharger les outils Android officiels et accepter leurs licences.\n\nAccepter et continuer ?"
            )
            evt.set()
        self.after(0, ask)
        evt.wait()
        return result["v"]

    def start(self):
        if self.worker and self.worker.is_alive():
            return
        self.stop_event.clear()
        self.button.config(state="disabled")
        self.progress.start(10)
        self.worker = threading.Thread(target=self.workflow, daemon=True)
        self.worker.start()

    def done(self, ok=True):
        def f():
            self.progress.stop()
            self.button.config(state="normal")
            if ok:
                self.button.config(text="RÉCUPÉRER À NOUVEAU")
        self.after(0, f)

    def on_close(self):
        self.stop_event.set()
        self._stop_emulator_process()
        self.destroy()

    def workflow(self):
        try:
            for p in (TOOLS, DOWNLOADS, OUTPUT_ROOT):
                p.mkdir(parents=True, exist_ok=True)
            self.ui("Préparation de l'environnement Windows…", "Cette étape n'est faite qu'une fois.")
            java_home = self.ensure_java()
            env = sdk_env(java_home)
            self.ensure_sdk(env)
            self.ensure_avd(env)
            self.ensure_rootavd()
            self.ensure_emulator_rooted(env)
            self.launch_maps(env)
            self.ui(
                "Connecte-toi à Google dans l'Android virtuel et restaure 'Vos trajets'.",
                "Dans Google Maps : photo de profil → Vos trajets → sauvegarde/nuage → restaure la sauvegarde. Le programme surveille automatiquement les données."
            )
            export = self.wait_for_timeline(env)
            self.ui("Terminé.", f"{export['count']} segments récupérés — de {export['earliest']} à {export['latest']}")
            try:
                os.startfile(str(export["folder"]))
            except Exception:
                pass
            self.after(0, lambda: messagebox.showinfo(
                "Extraction terminée",
                f"{export['count']} segments ont été récupérés.\n\nFichier :\n{export['json']}"
            ))
            self.done(True)
        except Exception as e:
            self.ui("Échec de l'extraction.", str(e))
            self.after(0, lambda: messagebox.showerror("PiiWii Timeline Extractor", str(e)))
            self.done(False)

    def ensure_java(self):
        home = find_java_home()
        if home:
            self.ui(detail=f"Java détecté : {home}")
            return home
        self.ui("Installation automatique de Java 17…", "Téléchargement d'Eclipse Temurin.")
        z = DOWNLOADS / "temurin17.zip"
        if not z.exists():
            download(TEMURIN_URL, z)
        unzip(z, JDK)
        home = find_java_home()
        if not home:
            raise RuntimeError("Java 17 n'a pas pu être installé.")
        return home

    def ensure_sdk(self, env):
        if sdkmanager_path().exists() and adb_path().exists() and emulator_path().exists():
            return
        if not self.ask_licenses():
            raise RuntimeError("Installation Android annulée : les licences SDK n'ont pas été acceptées.")
        self.ui("Installation des outils Android officiels…", "La première installation peut télécharger plusieurs gigaoctets.")
        z = DOWNLOADS / "commandlinetools.zip"
        if not z.exists() or sha256(z) != CMDLINE_ZIP_SHA256:
            if z.exists():
                z.unlink()
            download(CMDLINE_ZIP_URL, z)
        if sha256(z) != CMDLINE_ZIP_SHA256:
            raise RuntimeError("Le contrôle SHA-256 des outils Android a échoué.")
        tmp = TOOLS / "cmdline-tmp"
        unzip(z, tmp)
        latest = SDK / "cmdline-tools" / "latest"
        if latest.exists():
            shutil.rmtree(latest)
        latest.parent.mkdir(parents=True, exist_ok=True)
        source = tmp / "cmdline-tools"
        shutil.move(str(source), str(latest))
        shutil.rmtree(tmp, ignore_errors=True)
        env.update(sdk_env(Path(env["JAVA_HOME"])))
        run([sdkmanager_path(), "--licenses"], env=env, input_text=("y\n" * 200), timeout=300, check=False)
        run([sdkmanager_path(), "platform-tools", "emulator", SYSTEM_IMAGE], env=env, input_text=("y\n" * 40), timeout=3600)

    def ensure_avd(self, env):
        avd_dir = Path.home() / ".android" / "avd" / f"{AVD_NAME}.avd"
        if avd_dir.exists():
            return
        self.ui("Création de l'Android virtuel Google Play…", "Android 13 (API 33), isolé de ton téléphone.")
        run([avdmanager_path(), "create", "avd", "-n", AVD_NAME, "-k", SYSTEM_IMAGE, "-d", "pixel_6", "--force"], env=env, input_text="no\n", timeout=180)

    def ensure_rootavd(self):
        bat = ROOTAVD / "rootAVD.bat"
        if bat.exists():
            return
        self.ui("Préparation de l'accès à la base Timeline…", "Téléchargement de rootAVD pour l'Android virtuel uniquement.")
        z = DOWNLOADS / "rootAVD.zip"
        if not z.exists():
            download(ROOTAVD_URL, z)
        tmp = TOOLS / "rootavd-tmp"
        unzip(z, tmp)
        roots = list(tmp.glob("rootAVD-*/rootAVD.bat"))
        if not roots:
            raise RuntimeError("rootAVD.bat introuvable dans l'archive téléchargée.")
        src = roots[0].parent
        if ROOTAVD.exists():
            shutil.rmtree(ROOTAVD)
        shutil.move(str(src), str(ROOTAVD))
        shutil.rmtree(tmp, ignore_errors=True)

    def _adb_emulator_state(self, env):
        run([adb_path(), "start-server"], env=env, check=False, timeout=30)
        out = run([adb_path(), "devices"], env=env, check=False, timeout=30).stdout or ""

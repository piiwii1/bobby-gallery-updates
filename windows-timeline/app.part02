        for line in out.splitlines():
            line = line.strip()
            if line.startswith("emulator-"):
                parts = line.split()
                return parts[1] if len(parts) > 1 else "unknown"
        return None

    def _emulator_log_tail(self, max_chars=3500):
        log = LOCAL / "emulator-startup.log"
        try:
            text = log.read_text(encoding="utf-8", errors="replace")
            return text[-max_chars:].strip()
        except Exception:
            return ""

    def _stop_emulator_process(self):
        try:
            if self.emulator_proc and self.emulator_proc.poll() is None:
                self.emulator_proc.terminate()
                try:
                    self.emulator_proc.wait(timeout=10)
                except Exception:
                    self.emulator_proc.kill()
        except Exception:
            pass
        self.emulator_proc = None
        try:
            if self.emulator_log_handle:
                self.emulator_log_handle.close()
        except Exception:
            pass
        self.emulator_log_handle = None

    def _wait_for_adb_emulator(self, env, seconds):
        end = time.time() + seconds
        last_state = None
        while time.time() < end:
            if self.stop_event.is_set():
                raise RuntimeError("Opération annulée.")
            if self.emulator_proc and self.emulator_proc.poll() is not None:
                return False, f"emulator.exe s'est fermé (code {self.emulator_proc.returncode})."
            try:
                last_state = self._adb_emulator_state(env)
                if last_state == "device":
                    return True, "device"
            except Exception:
                pass
            self.ui(detail=f"Démarrage Android… état ADB : {last_state or 'pas encore détecté'}")
            time.sleep(2)
        return False, f"ADB n'a pas détecté l'émulateur après {seconds} secondes (dernier état : {last_state or 'aucun'})."

    def _wait_for_android_boot(self, env, seconds):
        end = time.time() + seconds
        while time.time() < end:
            if self.stop_event.is_set():
                raise RuntimeError("Opération annulée.")
            if self.emulator_proc and self.emulator_proc.poll() is not None:
                return False
            try:
                out = run([adb_path(), "shell", "getprop", "sys.boot_completed"], env=env, check=False, timeout=20).stdout.strip()
                if out == "1":
                    return True
            except Exception:
                pass
            time.sleep(3)
        return False

    def _launch_emulator_attempt(self, env, label, extra_args, connect_timeout, boot_timeout):
        self._stop_emulator_process()
        try:
            run([adb_path(), "kill-server"], env=env, check=False, timeout=30)
        except Exception:
            pass
        run([adb_path(), "start-server"], env=env, check=False, timeout=30)

        log = LOCAL / "emulator-startup.log"
        log.parent.mkdir(parents=True, exist_ok=True)
        self.emulator_log_handle = log.open("w", encoding="utf-8", errors="replace")
        args = [str(emulator_path()), "-avd", AVD_NAME, "-no-snapshot-load", "-no-boot-anim", "-no-audio"] + list(extra_args)
        self.ui("Démarrage de l'Android virtuel…", f"Essai : {label}. La fenêtre Android doit apparaître sur le PC.")
        self.emulator_proc = subprocess.Popen(
            args, env=env, stdout=self.emulator_log_handle, stderr=subprocess.STDOUT,
            creationflags=0
        )
        ok, reason = self._wait_for_adb_emulator(env, connect_timeout)
        if not ok:
            tail = self._emulator_log_tail()
            self._stop_emulator_process()
            return False, reason + ("\n\nJournal émulateur :\n" + tail if tail else "")

        self.ui("Android détecté par ADB…", f"{label} — attente de la fin du démarrage.")
        if not self._wait_for_android_boot(env, boot_timeout):
            tail = self._emulator_log_tail()
            self._stop_emulator_process()
            return False, "Android est visible par ADB mais n'a pas terminé son démarrage." + ("\n\nJournal émulateur :\n" + tail if tail else "")

        self.emulator_mode_args = list(extra_args)
        return True, ""

    def start_emulator(self, env):
        state = self._adb_emulator_state(env)
        if state == "device":
            if self._wait_for_android_boot(env, 300):
                return

        accel = run([emulator_path(), "-accel-check"], env=env, check=False, timeout=45).stdout or ""
        accel_short = " ".join(accel.split())[-700:]

        attempts = []
        if self.emulator_mode_args:
            attempts.append(("mode déjà validé", self.emulator_mode_args, 240, 480))
        attempts.extend([
            ("accélération matérielle + GPU automatique", ["-accel", "auto", "-gpu", "auto"], 240, 480),
            ("accélération matérielle + rendu logiciel", ["-accel", "auto", "-gpu", "swiftshader_indirect"], 300, 600),
            ("mode logiciel de secours (sans accélération)", ["-accel", "off", "-gpu", "swiftshader_indirect"], 600, 900),
        ])

        seen = set()
        errors = []
        for label, args, connect_timeout, boot_timeout in attempts:
            key = tuple(args)
            if key in seen:
                continue
            seen.add(key)
            ok, err = self._launch_emulator_attempt(env, label, args, connect_timeout, boot_timeout)
            if ok:
                return
            errors.append(f"{label}: {err}")

        message = "Impossible de démarrer l'Android virtuel."
        if accel_short:
            message += "\n\nDiagnostic accélération :\n" + accel_short
        if errors:
            message += "\n\nDernier diagnostic :\n" + errors[-1][-4500:]
        message += "\n\nLe journal complet est ici :\n" + str(LOCAL / "emulator-startup.log")
        raise RuntimeError(message)

    def is_rooted(self, env):
        p = run([adb_path(), "shell", "su", "-c", "id"], env=env, check=False, timeout=15)
        return "uid=0" in (p.stdout or "")


<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ch.piiwii.visited.VisitedMapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="72dp" />

    <ch.piiwii.visited.MarkerSettingsButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="#E6191B20"
        android:contentDescription="Paramètres"
        android:gravity="center"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="⚙"
        android:textColor="@color/text"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="14dp"
        android:background="#E6191B20"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="0 lieux"
        android:textColor="@color/text"
        android:textStyle="bold" />

    <ch.piiwii.visited.Beta4PlusButton
        android:id="@+id/btnLocate"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/fab_bg"
        android:contentDescription="Localiser ou ajouter"
        android:gravity="center"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone">
        <Button android:id="@+id/navMap" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/navPlaces" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/navAdd" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/navSync" android:layout_width="1dp" android:layout_height="1dp" />
    </LinearLayout>

    <ch.piiwii.visited.BottomNavBar
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom" />
</FrameLayout>

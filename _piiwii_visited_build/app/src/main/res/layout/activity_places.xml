<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingLeft="8dp" android:paddingRight="16dp">
        <Button android:id="@+id/back" style="?android:attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="‹ CARTE" android:textColor="@color/text" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mes lieux" android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>

    <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_marginRight="12dp" android:layout_marginBottom="8dp" android:background="#252830" android:hint="Rechercher un lieu…" android:padding="12dp" android:singleLine="true" android:textColor="@color/text" android:textColorHint="@color/text_dim" />
    <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#30333A" android:dividerHeight="1dp" />
</LinearLayout>

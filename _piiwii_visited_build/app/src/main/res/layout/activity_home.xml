<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="72dp"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="18dp"
            android:paddingRight="18dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TON CARNET DE VOYAGE"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="PiiWii Visited"
                android:textColor="@color/text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Ta carte personnelle de lieux visités"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/home_hero_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp"
                android:elevation="3dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL"
                        android:textColor="#D2A8AA"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/statTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="42sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="lieux enregistrés"
                        android:textColor="#D8DADF"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="#33E53935"
                    android:gravity="center"
                    android:text="⌖"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:background="@drawable/dashboard_card_bg"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PAYS" android:textColor="@color/text_dim" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/statCountries" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="—" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="différents" android:textColor="#8F95A0" android:textSize="12sp" />
                </LinearLayout>

                <Space android:layout_width="10dp" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:background="@drawable/dashboard_card_bg"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VILLES" android:textColor="@color/text_dim" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/statCities" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="—" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="identifiées" android:textColor="#8F95A0" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="94dp"
                    android:layout_weight="1"
                    android:background="@drawable/dashboard_card_bg"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MY MAPS" android:textColor="@color/accent" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/statMyMaps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="0" android:textColor="#FFFFFF" android:textSize="27sp" android:textStyle="bold" />
                </LinearLayout>

                <Space android:layout_width="10dp" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="94dp"
                    android:layout_weight="1"
                    android:background="@drawable/dashboard_card_bg"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AJOUTS APP" android:textColor="@color/accent2" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/statLocal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="0" android:textColor="#FFFFFF" android:textSize="27sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/geoStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/dashboard_card_bg"
                android:padding="14dp"
                android:text="Analyse géographique…"
                android:textColor="#AEB3BD"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Top pays"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/topCountries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/dashboard_card_bg"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="8dp"
                android:paddingRight="16dp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Top villes"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/topCities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/dashboard_card_bg"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="8dp"
                android:paddingRight="16dp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Origine des points"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ch.piiwii.visited.StatsChartView
                android:id="@+id/statsChart"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/dashboard_card_bg" />
        </LinearLayout>
    </ScrollView>

    <ch.piiwii.visited.BottomNavBar
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom" />
</FrameLayout>

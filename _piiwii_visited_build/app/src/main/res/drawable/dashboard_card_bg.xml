<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#20232B" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#55E53935" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#1B1E25" android:endColor="#15171C" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#343842" />
        </shape>
    </item>
</selector>
